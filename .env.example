# ==============================================================================
# EduQuest HOSA Mock Test Portal — Environment Configuration Example
# Copy this file to .env.local and fill in the values.
# NEVER commit your real .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public Supabase URL & Anon Key (safe for client-side usage via NEXT_PUBLIC)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for grading submissions against question_keys and admin seed script
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Admin Account Identity
# ------------------------------------------------------------------------------
ADMIN_EMAIL=rupali.eduquest@gmail.com
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# SMTP Configuration (Used by Edge Functions / Server Action for Email Dispatch)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rupali.eduquest@gmail.com
SMTP_PASS=
SMTP_FROM_NAME="EduQuest HOSA"
SMTP_FROM_EMAIL=rupali.eduquest@gmail.com

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

